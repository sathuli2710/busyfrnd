{
  "name": "@busyfrnd/customer-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "bundle:check": "expo export --platform android --output-dir dist",
    "build:android:apk": "eas build --platform android --profile preview",
    "build:ios:sim": "eas build --platform ios --profile preview",
    "build:production": "eas build --platform all --profile production"
  },
  "dependencies": {
    "@busyfrnd/api-client": "workspace:*",
    "@busyfrnd/mobile-core": "workspace:*",
    "@busyfrnd/shared": "workspace:*",
    "expo": "~53.0.27",
    "expo-constants": "~17.1.8",
    "expo-linking": "~7.1.7",
    "expo-location": "~18.1.6",
    "expo-notifications": "~0.31.5",
    "expo-router": "~5.1.11",
    "expo-secure-store": "~14.2.4",
    "expo-status-bar": "~2.2.3",
    "expo-web-browser": "~14.2.0",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "query-string": "^7.1.3",
    "expo-build-properties": "~0.14.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "19.0.10",
    "typescript": "~5.8.3"
  }
}
