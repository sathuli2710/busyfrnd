PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://busyfrnd:busyfrnd@localhost:5432/busyfrnd
JWT_SECRET=change-me-in-prod
# Public base URL of this API (used for payment return/webhook URLs + hosted checkout)
PUBLIC_API_URL=http://localhost:4000

# ---- Auth ----
# mock: built-in OTP login (OTP is always MOCK_OTP_CODE and printed to logs). clerk: verify Clerk session tokens.
AUTH_PROVIDER=mock
MOCK_OTP_CODE=123456
CLERK_SECRET_KEY=
# SMS / email providers: "mock" logs to console. Plug a DLT provider (MSG91/Twilio) in src/auth/providers.
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
SMTP_URL=
EMAIL_FROM="BusyFrnd <no-reply@busyfrnd.app>"

# ---- Cashfree (leave blank for the built-in mock gateway) ----
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=

# ---- AI (leave blank for the built-in rule-based fallback) ----
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# ---- Seed admin ----
ADMIN_EMAIL=admin@busyfrnd.app
ADMIN_PASSWORD=admin12345
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
